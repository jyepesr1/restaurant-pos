{
  // Faro's cloud API (ADR-016, docs/integraciones/neon-cloudflare.md).
  "$schema": "https://unpkg.com/wrangler@4.149.0/config-schema.json",
  "name": "faro-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true },
  // The owner's panel (task 1.11c-1, docs/PANEL.md): its files are served by Workers Static Assets
  // without running the Worker; the Worker runs first only for the API. `pnpm run deploy` builds
  // the panel first (wrangler refuses to deploy if this folder does not exist).
  "assets": {
    "directory": "../pos/dist-panel",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1/*"]
  },
  // First, cheap barrier on panel sign-ins, per IP and per restaurant:user (approximate and per
  // Cloudflare location; the real limit is panel_attempts in Postgres).
  "ratelimits": [
    {
      "name": "PANEL_LIMITER",
      // A number unique in the Cloudflare account, written as text (not a secret).
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  // The live panel (task 1.11c-2, docs/PANEL.md#en-vivo): one Durable Object per location keeps
  // the panels' WebSockets open (Hibernation API) and tells them when something changed. New
  // classes must use SQLite storage (docs/integraciones/panel-cloudflare.md, section 1); the
  // `migrations` array is used, not `exports` (the two cannot be mixed).
  "durable_objects": {
    "bindings": [{ "name": "PANEL_LIVE", "class_name": "PanelLive" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PanelLive"] }],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // The id shown by `wrangler hyperdrive create` (not a secret). The Neon connection string
      // lives only in Hyperdrive, never in this file.
      "id": "482abd5728404ed88ce40944a75e52df"
    }
  ]
}
