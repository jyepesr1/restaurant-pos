{
  // Faro's cloud API (ADR-016, docs/integraciones/neon-cloudflare.md).
  "$schema": "https://unpkg.com/wrangler@4.149.0/config-schema.json",
  "name": "faro-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": { "enabled": true },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // The id shown by `wrangler hyperdrive create` (not a secret). The Neon connection string
      // lives only in Hyperdrive, never in this file.
      "id": "482abd5728404ed88ce40944a75e52df"
    }
  ]
}
